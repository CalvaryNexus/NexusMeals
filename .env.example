# Template for LOCAL development (.env.local). Do not bulk-import this file
# into Vercel: blank values there override the real ones and break things.
# Every value except NEXT_PUBLIC_* is server-only and must stay secret.

# Upstash Redis. The Vercel Upstash integration sets KV_REST_API_URL and
# KV_REST_API_TOKEN automatically; UPSTASH_REDIS_REST_* also works.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Cloudflare Turnstile (site key is public, secret key is not)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Owner account, seeded only while no admin accounts exist
OWNER_EMAIL=
OWNER_PASSWORD=

# Long random string. Vercel Cron sends it as a Bearer token; the purge job
# refuses all calls while it is blank.
CRON_SECRET=

# Public https URL used for the QR code. Leave blank to use the current origin.
NEXT_PUBLIC_BASE_URL=
